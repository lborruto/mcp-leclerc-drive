{
  "name": "mcp-leclerc-drive",
  "version": "0.3.0",
  "private": true,
  "description": "Unofficial MCP server for E.Leclerc Drive: find your drive, search products and fill your cart from Claude, through your own Chrome. Nothing past the cart.",
  "type": "module",
  "bin": {
    "mcp-leclerc-drive": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && npm run clean:test && tsc -p tsconfig.test.json && node --test \"build-test/test/**/*.test.js\"",
    "clean:test": "node -e \"require('node:fs').rmSync('build-test',{recursive:true,force:true})\"",
    "check:hosts": "node scripts/check-hosts.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "leclerc",
    "leclerc-drive",
    "grocery",
    "courses"
  ],
  "author": "skunkobi, Luca Borruto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lborruto/mcp-leclerc-drive.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "homepage": "https://github.com/lborruto/mcp-leclerc-drive#readme",
  "bugs": {
    "url": "https://github.com/lborruto/mcp-leclerc-drive/issues"
  }
}
